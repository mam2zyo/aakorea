AAKOREA_DB_URL=jdbc:postgresql://localhost:5432/aakorea_main
AAKOREA_DB_USERNAME=aakorea_admin
AAKOREA_DB_PASSWORD=change-this-db-password
AAKOREA_ADMIN_USERNAME=admin
AAKOREA_ADMIN_PASSWORD=change-this-admin-password
AAKOREA_SERVER_PORT=8081
AAKOREA_KAKAO_REST_API_KEY=change-this-kakao-rest-api-key

# Wi-Fi keepalive (선택)
# 현재 A34 테스트 서버의 공유기 주소는 192.168.50.1 입니다.
# 다른 네트워크에서 쓰면 auto 또는 해당 게이트웨이 주소로 바꿔 주세요.
WIFI_KEEPALIVE_ENABLED=0
WIFI_KEEPALIVE_TARGET=192.168.50.1
WIFI_KEEPALIVE_INTERVAL=30
